{
  "name": "barodoc",
  "version": "8.0.0",
  "description": "Documentation framework powered by Astro",
  "type": "module",
  "bin": {
    "barodoc": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@barodoc/core": "workspace:*",
    "@barodoc/theme-docs": "workspace:*",
    "@barodoc/plugin-analytics": "workspace:*",
    "@barodoc/plugin-docsearch": "workspace:*",
    "@barodoc/plugin-llms-txt": "workspace:*",
    "@barodoc/plugin-og-image": "workspace:*",
    "@barodoc/plugin-openapi": "workspace:*",
    "@barodoc/plugin-pwa": "workspace:*",
    "@barodoc/plugin-rss": "workspace:*",
    "@barodoc/plugin-search": "workspace:*",
    "@barodoc/plugin-sitemap": "workspace:*",
    "astro": "^5.0.0",
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/react": "^4.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "cac": "^6.7.14",
    "chokidar": "^4.0.0",
    "execa": "^9.5.0",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "documentation",
    "astro",
    "mdx",
    "cli",
    "barodoc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/barocss/barodoc.git",
    "directory": "packages/barodoc"
  }
}
