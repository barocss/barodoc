---
interface Props {
  url: string;
  renderedHtml?: string | null;
  headerHtml?: string | null;
}
const { url, renderedHtml = null } = Astro.props;
---
<div class="asset-rst-wrapper w-full rounded-lg overflow-hidden border border-[var(--bd-border)] p-6">
  {renderedHtml ? (
    <div
      class="rst-content prose prose-sm dark:prose-invert max-w-none"
      set:html={renderedHtml}
    />
  ) : (
    <p class="text-[var(--bd-text-secondary)]">RST could not be compiled. <a href={url} download class="text-primary-600 dark:text-primary-400 hover:underline">Download .rst file</a>.</p>
  )}
  <div class="mt-4 flex gap-4 text-sm">
    <a href={url} download class="text-primary-600 dark:text-primary-400 hover:underline">Download .rst file</a>
  </div>
</div>
