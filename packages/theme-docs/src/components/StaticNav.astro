---
import config from "virtual:barodoc/config";
import { ThemeToggle } from "./ThemeToggle";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;
const tabs = config.tabs ?? [];
---

<header class="sticky top-0 z-50 w-full min-w-0 border-b border-[var(--bd-border)] bg-[var(--bd-bg)]/95 backdrop-blur-md supports-[backdrop-filter]:bg-[var(--bd-bg)]/80">
  <div class="flex h-14 items-center justify-between gap-2 px-4 sm:px-6 max-w-[1280px] mx-auto min-w-0">
    {/* Left: hamburger (mobile) + logo + tabs (desktop) */}
    <div class="flex items-center gap-3 md:gap-6 min-w-0 shrink">
      {/* Hamburger on left so it matches sheet sliding from left */}
      <button
        type="button"
        class="xl:hidden h-9 w-9 -ml-1 flex items-center justify-center rounded-lg text-[var(--bd-text-secondary)] hover:text-[var(--bd-text)] hover:bg-[var(--bd-bg-subtle)] shrink-0"
        aria-label="Menu"
        data-static-nav-menu
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <a
        href="/"
        class="flex items-center gap-2.5 min-w-0 shrink overflow-hidden font-semibold text-[var(--bd-text-heading)] hover:opacity-80 transition-opacity"
      >
        {config.logo && <img src={config.logo} alt={config.name} class="h-7 w-7 shrink-0" />}
        <span class="text-[15px] tracking-tight truncate">{config.name}</span>
      </a>
      {tabs.length > 0 && (
        <nav class="hidden xl:flex items-center gap-1">
          {tabs.map((tab: { label: string; href: string }) => {
            const isActive = currentPath === tab.href || currentPath.startsWith(tab.href + "/");
            return (
              <a
                href={tab.href}
                class:list={[
                  "px-3 py-1.5 text-[13px] font-medium rounded-lg transition-colors",
                  isActive
                    ? "text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-950/50"
                    : "text-[var(--bd-text-secondary)] hover:text-[var(--bd-text)] hover:bg-[var(--bd-bg-subtle)]",
                ]}
              >
                {tab.label}
              </a>
            );
          })}
        </nav>
      )}
    </div>
    {/* Right: GitHub + theme */}
    <div class="flex items-center gap-1.5 shrink-0">
      {config.topbar?.github && (
        <a
          href={config.topbar.github}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg text-[var(--bd-text-secondary)] hover:text-[var(--bd-text)] hover:bg-[var(--bd-bg-subtle)]"
          aria-label="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </a>
      )}
      <ThemeToggle client:load />
    </div>
  </div>
</header>
<script>
  document.querySelectorAll('[data-static-nav-menu]').forEach((btn) => {
    btn.addEventListener('click', () => document.dispatchEvent(new CustomEvent('toggle-mobile-nav')));
  });
</script>
