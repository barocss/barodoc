---
import path from "node:path";
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import config from "virtual:barodoc/config";
import { defaultLocale, locales } from "virtual:barodoc/i18n";
import { getLocalizedNavGroup } from "@barodoc/core";
import readingTime from "reading-time";
import { scanSectionAssets, getContentSectionsBasePath } from "../../lib/scanAssets.js";
import { getViewerType } from "../../lib/assetExtensions.js";

export async function getStaticPaths() {
  const sections = [
    { slug: "docs", label: "Documentation", navigation: config.navigation },
    ...(config.sections ?? []).map((s: any) => ({
      slug: s.slug,
      label: s.label ?? s.slug,
      navigation: s.navigation,
    })),
  ];
  const paths: any[] = [];

  for (const section of sections) {
    let docs: any[];
    try {
      docs = await getCollection(section.slug as any);
    } catch {
      continue;
    }

    const existingInnerPaths = new Set(
      docs.map((d: any) => {
        const docId = d.slug ?? d.id;
        const parts = docId.split("/");
        const hasLocale = locales.includes(parts[0]);
        return hasLocale
          ? parts[0] === defaultLocale
            ? parts.slice(1).join("/")
            : docId
          : docId;
      })
    );

    for (const doc of docs) {
      const docId = doc.slug ?? doc.id;
      const slugParts = docId.split("/");
      const hasLocale = locales.includes(slugParts[0]);

      let locale = defaultLocale;
      let cleanSlug = docId;

      if (hasLocale) {
        locale = slugParts[0];
        cleanSlug = slugParts.slice(1).join("/");
      }

      const innerPath = locale === defaultLocale
        ? cleanSlug
        : `${locale}/${cleanSlug}`;

      paths.push({
        params: { section: section.slug, slug: innerPath || undefined },
        props: { doc, assetEntry: null, locale, cleanSlug, sectionSlug: section.slug, sectionNav: section.navigation },
      });
    }

    const basePath = getContentSectionsBasePath();
    const sectionContentDir = path.join(basePath, section.slug);
    const assetEntries = scanSectionAssets(sectionContentDir, section.slug);
    for (const asset of assetEntries) {
      const slugParts = asset.slug.split("/");
      const hasLocale = locales.includes(slugParts[0]);
      const locale = hasLocale ? slugParts[0] : defaultLocale;
      const innerPath = hasLocale
        ? slugParts[0] === defaultLocale
          ? slugParts.slice(1).join("/")
          : asset.slug
        : asset.slug;
      if (existingInnerPaths.has(innerPath)) continue;
      paths.push({
        params: { section: section.slug, slug: innerPath || undefined },
        props: {
          assetEntry: {
            slug: asset.slug,
            relPath: asset.relPath,
            ext: asset.ext,
            viewerType: getViewerType(asset.ext),
            sectionSlug: section.slug,
          },
          doc: null,
          locale,
          cleanSlug: innerPath,
          sectionSlug: section.slug,
          sectionNav: section.navigation,
        },
      });
    }
  }
  return paths;
}

interface Props {
  doc: any;
  assetEntry?: {
    slug: string;
    relPath: string;
    ext: string;
    viewerType: string;
    sectionSlug: string;
  } | null;
  locale: string;
  cleanSlug: string;
  sectionSlug: string;
  sectionNav: typeof config.navigation;
}

const { doc, assetEntry = null, locale, cleanSlug, sectionSlug, sectionNav } = Astro.props;
const isAsset = !!assetEntry;

let Content: any;
let headings: any[];
let readTime = { text: "" };
if (!isAsset) {
  const rendered = await render(doc);
  Content = rendered.Content;
  headings = rendered.headings;
  readTime = readingTime(doc.body ?? "");
}

function findCategory(slug: string): string | null {
  for (const group of sectionNav) {
    if (group.pages.includes(slug)) {
      return getLocalizedNavGroup(group, locale, defaultLocale);
    }
  }
  return null;
}

function getAllPages(): string[] {
  const pages: string[] = [];
  for (const group of sectionNav) {
    pages.push(...group.pages);
  }
  return pages;
}

function getPageTitle(slug: string): string {
  const parts = slug.split('/');
  const name = parts[parts.length - 1];
  return name
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

function getPageHref(slug: string): string {
  return `/${sectionSlug}/${locale === defaultLocale ? slug : `${locale}/${slug}`}`;
}

const allPages = getAllPages();
const currentIndex = allPages.indexOf(cleanSlug);

const prevPage = currentIndex > 0
  ? { title: getPageTitle(allPages[currentIndex - 1]), href: getPageHref(allPages[currentIndex - 1]) }
  : null;

const nextPage = currentIndex < allPages.length - 1
  ? { title: getPageTitle(allPages[currentIndex + 1]), href: getPageHref(allPages[currentIndex + 1]) }
  : null;

const category = findCategory(cleanSlug);

const editBaseUrl = config.editLink?.baseUrl;
const editUrl = !isAsset && editBaseUrl
  ? `${editBaseUrl.replace(/\/$/, "")}/${doc.id}`
  : null;

let lastUpdated: Date | null = null;
if (!isAsset && config.lastUpdated) {
  const mod = (doc.data as Record<string, unknown>).lastUpdated;
  if (mod instanceof Date) {
    lastUpdated = mod;
  }
}

const breadcrumbs: { label: string; href?: string }[] = [];
if (category) {
  breadcrumbs.push({ label: category });
}
const pageTitle = isAsset
  ? getPageTitle(cleanSlug)
  : doc.data.title;
breadcrumbs.push({ label: pageTitle });
---

<DocsLayout
  title={pageTitle}
  description={!isAsset ? doc.data.description : undefined}
  headings={isAsset ? [] : headings}
  prevPage={prevPage}
  nextPage={nextPage}
  editUrl={editUrl}
  lastUpdated={lastUpdated}
  breadcrumbs={breadcrumbs}
  readingTime={readTime.text}
  filePath={isAsset ? undefined : `src/content/${sectionSlug}/${doc.id}`}
  sectionSlug={sectionSlug}
>
  {isAsset ? (
    <p>Asset: {assetEntry!.slug}</p>
  ) : (
    <>
      {category && (
        <p class="text-xs font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400 mb-3">
          {category}
        </p>
      )}
      <h1>{doc.data.title}</h1>
      {doc.data.description && (
        <p class="lead text-base text-[var(--bd-text-secondary)] mt-2 mb-6 leading-relaxed">
          {doc.data.description}
        </p>
      )}
      <Content />
    </>
  )}
</DocsLayout>
