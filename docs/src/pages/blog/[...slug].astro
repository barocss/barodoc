---
import { getCollection, render } from "astro:content";
import BlogLayout from "@barodoc/theme-docs/layouts/BlogLayout.astro";
import readingTime from "reading-time";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => {
    const slug = post.data.urlSlug ?? post.id.replace(/\.(mdx?|md)$/, "");
    return { params: { slug }, props: { post } };
  });
}

interface Props {
  post: Awaited<ReturnType<typeof getCollection<"blog">>>[number];
}

const { post } = Astro.props;
const { Content } = await render(post);
const readTime = readingTime(post.body ?? "");
---

<BlogLayout
  title={post.data.title}
  description={post.data.description || post.data.excerpt}
  date={post.data.date ? new Date(post.data.date) : undefined}
  author={post.data.author}
  avatar={post.data.avatar}
  image={post.data.image}
  tags={post.data.tags}
  readingTime={readTime.text}
>
  <Content />
</BlogLayout>
